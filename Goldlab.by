#!/usr/bin/env python3
"""GoldLab v0.1 - XAU/USD PAPER trader. Standard library only.

PAPER ONLY: this script never places real orders.
Each run: fetch M15 candles -> replay every NEW closed candle -> update ledger.json.
Because it replays candles, a delayed run does not miss anything.
"""
import json
import os
import sys
import urllib.parse
import urllib.request
from datetime import datetime, timedelta, timezone

# ---------------- settings (change one thing at a time) ----------------
SYMBOL = "XAU/USD"
INTERVAL = "15min"
OUTPUTSIZE = 1500            # about 15 trading days of M15 candles
LEDGER = "ledger.json"
SUMMARY = "last_run.txt"

START_BALANCE = 1000.0
RISK_PCT = 0.005             # 0.5% of balance risked per trade
DAILY_LOSS_LIMIT = 0.02      # stop new trades after -2% on the UTC day
MAX_DRAWDOWN = 0.05          # halt everything at -5% from peak
MAX_OPEN = 1                 # one trade at a time (keeps risk <= 0.5%)
COST_PER_SIDE = 0.50         # spread + slippage assumption, $ per oz per side
ATR_MULT = 1.5               # stop distance = 1.5 x ATR(14) on M15
RR = 2.0                     # take profit = 2 x stop distance
RSI_LONG = 45                # buy when RSI crosses back up through this
RSI_SHORT = 55               # sell when RSI crosses back down through this
# -----------------------------------------------------------------------

STEP = timedelta(minutes=15)


def iso(t):
    return t.isoformat()


def parse(s):
    return datetime.fromisoformat(s)


def fetch_candles(key):
    q = urllib.parse.urlencode({
        "symbol": SYMBOL, "interval": INTERVAL, "outputsize": OUTPUTSIZE,
        "timezone": "UTC", "apikey": key,
    })
    with urllib.request.urlopen("https://api.twelvedata.com/time_series?" + q, timeout=30) as r:
        data = json.load(r)
    if data.get("status") != "ok":
        raise RuntimeError("API error: " + str(data.get("message", data))[:200])
    out = []
    for v in data["values"]:
        t = datetime.strptime(v["datetime"], "%Y-%m-%d %H:%M:%S").replace(tzinfo=timezone.utc)
        out.append({"t": t, "o": float(v["open"]), "h": float(v["high"]),
                    "l": float(v["low"]), "c": float(v["close"])})
    out.sort(key=lambda x: x["t"])
    return out


# ---------------- indicators ----------------
def ema(vals, n):
    k = 2.0 / (n + 1)
    out, e = [], None
    for v in vals:
        e = v if e is None else v * k + e * (1 - k)
        out.append(e)
    return out


def rsi(closes, n=14):
    out = [None] * len(closes)
    if len(closes) <= n:
        return out
    gains = losses = 0.0
    for i in range(1, n + 1):
        d = closes[i] - closes[i - 1]
        gains += max(d, 0)
        losses += max(-d, 0)
    ag, al = gains / n, losses / n
    out[n] = 100 - 100 / (1 + ag / al) if al else 100.0
    for i in range(n + 1, len(closes)):
        d = closes[i] - closes[i - 1]
        ag = (ag * (n - 1) + max(d, 0)) / n
        al = (al * (n - 1) + max(-d, 0)) / n
        out[i] = 100 - 100 / (1 + ag / al) if al else 100.0
    return out


def atr(c, n=14):
    out = [None] * len(c)
    trs = []
    for i in range(len(c)):
        if i == 0:
            tr = c[i]["h"] - c[i]["l"]
        else:
            pc = c[i - 1]["c"]
            tr = max(c[i]["h"] - c[i]["l"], abs(c[i]["h"] - pc), abs(c[i]["l"] - pc))
        trs.append(tr)
    if len(trs) < n:
        return out
    a = sum(trs[:n]) / n
    out[n - 1] = a
    for i in range(n, len(trs)):
        a = (a * (n - 1) + trs[i]) / n
        out[i] = a
    return out


def floor_hour(t):
    return t.replace(minute=0, second=0, microsecond=0)


def market_open_for_entries(t):
    wd = t.weekday()  # Mon=0 ... Sun=6 (UTC)
    if wd == 5:
        return False
    if wd == 6 and t.hour < 23:
        return False
    if wd == 4 and t.hour >= 20:
        return False
    return True


# ---------------- ledger ----------------
def new_state(now_day):
    return {"balance": START_BALANCE, "peak": START_BALANCE, "halted": False,
            "day": now_day, "day_start_balance": START_BALANCE,
            "last_processed": None, "open": [], "closed": [], "next_id": 1}


def load_state(now_day):
    if os.path.exists(LEDGER):
        with open(LEDGER) as f:
            return json.load(f)
    return new_state(now_day)


def save_state(state):
    with open(LEDGER, "w") as f:
        json.dump(state, f, indent=1)


def process(state, candles):
    """Replay every candle newer than state['last_processed']. Returns list of event strings."""
    events = []
    if not candles:
        return events
    if state["last_processed"] is None:
        # first run: start from now, do not replay history
        state["last_processed"] = iso(candles[-1]["t"])
        state["day"] = candles[-1]["t"].strftime("%Y-%m-%d")
        events.append("Pehla run: paper trading is candle ke baad se shuru hogi.")
        return events

    last = parse(state["last_processed"])
    closes = [c["c"] for c in candles]
    e20 = ema(closes, 20)
    rs = rsi(closes, 14)
    at = atr(candles, 14)

    h_order, h_close = [], {}
    for c in candles:
        h = floor_hour(c["t"])
        if h not in h_close:
            h_order.append(h)
        h_close[h] = c["c"]
    h_vals = [h_close[h] for h in h_order]
    h20, h50 = ema(h_vals, 20), ema(h_vals, 50)
    h_idx = {h: i for i, h in enumerate(h_order)}

    def trend(t):
        comp = floor_hour(t + STEP) - timedelta(hours=1)   # last fully completed hour
        i = h_idx.get(comp)
        if i is None or i < 50:
            return 0
        if h20[i] > h50[i] and h_vals[i] > h50[i]:
            return 1
        if h20[i] < h50[i] and h_vals[i] < h50[i]:
            return -1
        return 0

    for i, c in enumerate(candles):
        if c["t"] <= last:
            continue
        day = c["t"].strftime("%Y-%m-%d")
        if state["day"] != day:
            state["day"] = day
            state["day_start_balance"] = state["balance"]

        # 1) manage open trades using this candle's high/low
        for tr in list(state["open"]):
            if parse(tr["entry_time"]) > c["t"]:
                continue
            buy = tr["side"] == "buy"
            hit_sl = c["l"] <= tr["sl"] if buy else c["h"] >= tr["sl"]
            hit_tp = c["h"] >= tr["tp"] if buy else c["l"] <= tr["tp"]
            if not (hit_sl or hit_tp):
                continue
            reason = "SL" if hit_sl else "TP"      # both in one candle -> assume SL (conservative)
            level = tr["sl"] if hit_sl else tr["tp"]
            px = level - COST_PER_SIDE if buy else level + COST_PER_SIDE
            pnl = round((px - tr["entry"]) * tr["oz"] if buy else (tr["entry"] - px) * tr["oz"], 2)
            state["balance"] = round(state["balance"] + pnl, 2)
            tr.update({"exit_time": iso(c["t"] + STEP), "exit": round(px, 2),
                       "pnl": round(pnl, 2), "reason": reason})
            state["open"].remove(tr)
            state["closed"].append(tr)
            state["peak"] = max(state["peak"], state["balance"])
            events.append("CLOSE #%d %s %s pnl $%.2f" % (tr["id"], tr["side"], reason, pnl))
            if (state["peak"] - state["balance"]) / state["peak"] >= MAX_DRAWDOWN:
                state["halted"] = True
                events.append("HALT: drawdown limit -5% hit. Naya trade band, tumhari manzoori chahiye.")

        # 2) look for a new entry at this candle's close
        if state["halted"] or len(state["open"]) >= MAX_OPEN:
            continue
        if not market_open_for_entries(c["t"]):
            continue
        if (state["day_start_balance"] - state["balance"]) / state["day_start_balance"] >= DAILY_LOSS_LIMIT:
            continue
        if i < 60 or rs[i] is None or rs[i - 1] is None or at[i] is None:
            continue
        d = trend(c["t"])
        side = None
        if d == 1 and rs[i - 1] < RSI_LONG <= rs[i] and c["c"] > e20[i]:
            side = "buy"
        elif d == -1 and rs[i - 1] > RSI_SHORT >= rs[i] and c["c"] < e20[i]:
            side = "sell"
        if side:
            dist = ATR_MULT * at[i]
            entry = c["c"] + COST_PER_SIDE if side == "buy" else c["c"] - COST_PER_SIDE
            sl = entry - dist if side == "buy" else entry + dist
            tp = entry + RR * dist if side == "buy" else entry - RR * dist
            oz = state["balance"] * RISK_PCT / (dist + COST_PER_SIDE)
            tr = {"id": state["next_id"], "side": side, "entry_time": iso(c["t"] + STEP),
                  "entry": round(entry, 2), "sl": round(sl, 2), "tp": round(tp, 2),
                  "oz": round(oz, 4), "risk_usd": round(state["balance"] * RISK_PCT, 2),
                  "why": "H1 trend + M15 RSI %.0f->%.0f, ATR %.2f" % (rs[i - 1], rs[i], at[i])}
            state["next_id"] += 1
            state["open"].append(tr)
            events.append("OPEN #%d %s @%.2f SL %.2f TP %.2f (%.2f lot)" %
                          (tr["id"], side, entry, sl, tp, oz / 100))

    state["last_processed"] = iso(candles[-1]["t"])
    return events


def stats_line(state):
    cl = state["closed"]
    wins = [t["pnl"] for t in cl if t["pnl"] > 0]
    losses = [-t["pnl"] for t in cl if t["pnl"] <= 0]
    n = len(cl)
    wr = (100.0 * len(wins) / n) if n else 0.0
    pf = (sum(wins) / sum(losses)) if losses and sum(losses) > 0 else None
    pf_txt = "%.2f" % pf if pf is not None else "n/a"
    return n, wr, pf_txt


def write_summary(state, candles, events, new_count, now):
    last = candles[-1]
    dd = 100.0 * (state["peak"] - state["balance"]) / state["peak"]
    day_pl = state["balance"] - state["day_start_balance"]
    n, wr, pf = stats_line(state)
    lines = [
        "GoldLab v0.1 | run %s UTC" % now.strftime("%Y-%m-%d %H:%M"),
        "Last closed candle: %s UTC | close %.2f | new candles: %d" %
        (last["t"].strftime("%Y-%m-%d %H:%M"), last["c"], new_count),
        "Events: " + ("; ".join(events) if events else "none"),
        "Balance $%.2f | peak $%.2f | drawdown %.2f%% | today P/L $%.2f" %
        (state["balance"], state["peak"], dd, day_pl),
        "Closed trades: %d | win rate %.0f%% | profit factor %s | open: %d | halted: %s" %
        (n, wr, pf, len(state["open"]), "YES" if state["halted"] else "no"),
    ]
    for t in state["open"]:
        lines.append("OPEN #%d %s entry %.2f SL %.2f TP %.2f" %
                     (t["id"], t["side"], t["entry"], t["sl"], t["tp"]))
    lines.append("PAPER ONLY. Research, not financial advice.")
    text = "\n".join(lines)
    with open(SUMMARY, "w") as f:
        f.write(text + "\n")
    print(text)


def main():
    key = os.environ.get("TWELVE_KEY", "").strip()
    if not key:
        print("ERROR: TWELVE_KEY secret nahi mila.")
        sys.exit(1)
    now = datetime.now(timezone.utc)
    try:
        candles = fetch_candles(key)
    except Exception as e:  # do not leak the key
        print("DATA ERROR:", str(e).replace(key, "***"))
        sys.exit(1)
    candles = [c for c in candles if c["t"] + STEP <= now]   # drop the still-forming candle
    if len(candles) < 100:
        print("DATA ERROR: bohat kam candles mile:", len(candles))
        sys.exit(1)
    state = load_state(candles[-1]["t"].strftime("%Y-%m-%d"))
    before = state["last_processed"]
    events = process(state, candles)
    new_count = sum(1 for c in candles if before is None or c["t"] > parse(before))
    save_state(state)
    write_summary(state, candles, events, new_count, now)


if __name__ == "__main__":
    main()
